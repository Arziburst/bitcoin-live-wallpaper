<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- D-34: the Windows 10 SDK projection for Windows.System.UserProfile.LockScreen; x64 because
         LockScreen.SetImageFileAsync does not work from an x86 process on x64 Windows (probe #39). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- D-14: the owner's icon for the exe, the tray and the installer (assets/icon/build-ico.ps1). -->
    <ApplicationIcon>..\..\assets\icon\app.ico</ApplicationIcon>
    <AssemblyName>BitcoinWallpaper</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Idle footprint (D-6): no ICU, no background GC thread. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chart.Core\Chart.Core.csproj" />
    <ProjectReference Include="..\Market.Data\Market.Data.csproj" />
    <ProjectReference Include="..\Chart.Render.D2D\Chart.Render.D2D.csproj" />
  </ItemGroup>

</Project>
